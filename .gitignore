# ---------------------------------------------------------------------------
# Python bytecode / build artefacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / distribution
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
MANIFEST

# PyInstaller (main.py calls freeze_support() for bundling)
*.spec
*.manifest

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
.env
.env.*

# ---------------------------------------------------------------------------
# Testing / coverage / type checkers / linters
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json

# ---------------------------------------------------------------------------
# PyExplorer runtime files
# (normally written to the user's config dir, but can land in the repo when
#  PYEXPLORER_CONFIG_DIR points here, e.g. a "portable" or test run)
# ---------------------------------------------------------------------------
pyexplorer.log
*.log
*.broken
*.json.tmp
credentials.json
saved_logins.json
pyexplorer-settings.json
.pyexplorer/
portable-config/

# Qt Designer / Qt Creator user files
*.pro.user
*.ui.autosave

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.spyproject/

# Claude Code local settings
.claude/settings.local.json

# ---------------------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
